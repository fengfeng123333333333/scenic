	"uniIdRouter": {},
	"easycom": {
		"autoscan": true,
		"custom": {
			"^u--(.*)": "uview-plus/components/u-$1/u-$1.vue",
			"^up-(.*)": "uview-plus/components/u-$1/u-$1.vue",
			"^u-([^-].*)": "uview-plus/components/u-$1/u-$1.vue",
			"^tab-bar$": "@/components/tabbar/tabbar.vue",
			"^f-tabs$": "@/components/f-tabs/f-tabs.vue",
			"^uni-popup$": "@/components/uni-popup/uni-popup.vue"
		}
	}
